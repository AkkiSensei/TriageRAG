# TriageRAG Environment Configuration Example
# Copy to .env for local overrides if needed.
# Pure offline deterministic architecture - no external network API keys required.

# Optional: Path to data directory (defaults to auto-discovery from repo root)
# TRIAGERAG_DATA_DIR=data

# Optional: Retrieval backend selection ('bm25', 'char_ngram', 'hybrid_rrf', 'hybrid_rrf_rerank')
# TRIAGERAG_RETRIEVAL_BACKEND=bm25

# Security/Privacy flags
# Untrusted patient chief complaint is excluded from LLM/retrieval by default
TRIAGERAG_INCLUDE_COMPLAINT_IN_LLM=false
